{
  "name": "lor",
  "version": "0.0.0",
  "private": true,
  "description": "LOR. — open-source video meetings that remember. No account, no time limit, no download.",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "npm run start --workspace web",
    "lint": "npm run lint --workspace web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prepare": "node .husky/install.mjs",
    "db:generate": "npm run db:generate --workspace @lor/db",
    "db:migrate": "npm run db:migrate --workspace @lor/db",
    "db:studio": "npm run db:studio --workspace @lor/db",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7"
  }
}
