# ---------------------------------------------------------------------------
# LOR configuration
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- LiveKit (required) ----------------------------------------------------
# Create a free project at https://cloud.livekit.io, or point these at your
# own SFU when self-hosting.
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Database (required) ---------------------------------------------------
# Any Postgres works. Supabase free tier is the documented default.
DATABASE_URL=postgresql://user:password@host:5432/lor

# --- Application (required) ------------------------------------------------
# Signs the cookie that identifies a room host. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOR_HOST_COOKIE_SECRET=

# Public origin, used for building join links and QR codes.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI (all optional)
#
# Leave these empty and LOR still works: the meeting, chat, whiteboard, and
# recording never depend on an AI provider. Users can always supply their own
# key in Settings, which stays in their browser and is sent straight to the
# provider.
#
# Set them to offer AI features to everyone out of the box using your key,
# bounded by the quotas below. No key is ever written to the database.
# ---------------------------------------------------------------------------

# Speech-to-text. Groq is the default: whisper-large-v3-turbo, and its free
# tier allows 28,800 audio seconds per day. https://console.groq.com/keys
LOR_STT_PROVIDER=groq
LOR_STT_MODEL=whisper-large-v3-turbo
LOR_STT_API_KEY=

# Summaries, decisions, and action items. Any OpenAI-compatible endpoint.
LOR_LLM_PROVIDER=groq
LOR_LLM_MODEL=llama-3.3-70b-versatile
LOR_LLM_API_KEY=
# Only needed for a custom or self-hosted endpoint (Ollama, LM Studio, ...).
LOR_LLM_BASE_URL=

# --- Quotas ----------------------------------------------------------------
# How much of your key each visitor may spend per day before LOR asks them to
# bring their own. Set to 0 to disable your key entirely and require BYOK.
LOR_FREE_STT_SECONDS_PER_USER_PER_DAY=900
LOR_FREE_LLM_TOKENS_PER_USER_PER_DAY=50000

# Server-wide daily ceiling. Keep this below your provider's own limit so a
# busy day cannot exhaust the account.
LOR_FREE_STT_SECONDS_GLOBAL_PER_DAY=20000
LOR_FREE_LLM_TOKENS_GLOBAL_PER_DAY=2000000
